{
  "name": "NC Dev",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": "..",
    "options": [
      "--pull=false"
    ]
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
  "workspaceFolder": "/workspace",
  "remoteUser": "root",
  "remoteEnv": {
    "PATH": "/opt/conda/envs/jh_env/bin:${containerEnv:PATH}"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter",
        "ms-azuretools.vscode-docker",
        "openai.chatgpt"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/opt/conda/envs/jh_env/bin/python",
        "python.terminal.activateEnvironment": true
      }
    }
  },
  "postCreateCommand": "conda run -n jh_env python --version"
}
